# /root/deploy/redactplus-forum/forum.env — mode 600, never committed.
# Generate each secret with:  openssl rand -base64 48 | tr -d '\n=' | tr '+/' '-_'

# The address administrators use for NodeBB's own UI through the SSH tunnel (RUNBOOK.md).
FORUM_URL=http://localhost:6097
# NodeBB's session secret.
FORUM_SECRET=
# Shared with the portal's PORTAL_FORUM_BRIDGE_KEY. 32+ characters.
REDACTPLUS_BRIDGE_KEY=

# The forum database (same values as db.env).
FORUM_DB_NAME=redactplus_forum
FORUM_DB_USER=redactplus_forum
FORUM_DB_PASSWORD=

# The first administrator, created on the very first start only (password in secrets/admin-password).
FORUM_ADMIN_USERNAME=forum-admin
FORUM_ADMIN_EMAIL=

# The identity provider role that makes someone a forum moderator, and how long moderator
# rights last without being re-confirmed by a portal request (minutes).
REDACTPLUS_BRIDGE_MODERATOR_ROLE=forum-moderator
REDACTPLUS_BRIDGE_MODERATOR_TTL_MINUTES=15
# Posting needs a verified email at the identity provider.
REDACTPLUS_BRIDGE_REQUIRE_VERIFIED_EMAIL=true
