#!/bin/bash
# /usr/local/sbin/redactplus-deploy: the ONLY command the GitHub Actions deploy key can run.
#
# Installed by hand (deployment/cd/README.md), never by the pipeline:
#   install -m 750 -o root -g root redactplus-deploy /usr/local/sbin/redactplus-deploy
#   /root/.ssh/authorized_keys, one line for a key used by nothing else:
#     restrict,command="/usr/local/sbin/redactplus-deploy" ssh-ed25519 AAAA… github-actions-redactplus-cd
#
# `restrict` disables forwarding, the PTY and user rc files; sshd ignores whatever the client
# asks to run except through SSH_ORIGINAL_COMMAND, parsed strictly below. Requests:
#
#   status   <component>
#   deploy   <component> <tag> <sha256:digest> <run-number>
#   rollback <component> <run-number>
#
# What it changes: the component's .env release pin (keeping .env.previous) and that one
# Compose service. It never reads or prints app.env, db.env or credentials, never touches nginx,
# Keycloak, the database schema or other services, and never deletes images or volumes.
#
# Output is key=value lines the workflow parses. Exit codes: 0 done, 3 skipped (stale or already
# deployed), 1 failed (the previous release was restored), 2 refused (bad request or lock busy).
set -euo pipefail
umask 077
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
readonly DEPLOY_ROOT=/root/deploy
readonly HOME_SITE=/etc/nginx/sites-available/home.redactplus.io

refuse() { echo "result=refused"; echo "reason=$1"; exit 2; }
read -r -a args <<< "${SSH_ORIGINAL_COMMAND:-}"
action="${args[0]:-}"
component="${args[1]:-}"

case "$component" in
  marketing)
    dir="$DEPLOY_ROOT/redactplus-landing"; service=redactplus-landing; port=6095
    repo=registry.safaridesk.io/safari/redactplus-landing ;;
  portal)
    dir="$DEPLOY_ROOT/redactplus-portal"; service=redactplus-portal; port=6096
    repo=registry.safaridesk.io/safari/redactplus-portal ;;
  *) refuse "unknown component" ;;
esac
[ -d "$dir" ] || refuse "deploy directory missing"
cd "$dir"

now() { date -u +%FT%TZ; }
pin() { grep -E "^$1=" .env 2>/dev/null | head -1 | cut -d= -f2- || true; }
last_run() { cat .deploy-run 2>/dev/null || echo 0; }
json() { printf '%s' "$1" | tr -d '"\\\n' | cut -c1-200; }

record() { # action outcome commit digest run previous
  printf '{"time":"%s","component":"%s","action":"%s","outcome":"%s","commit":"%s","digest":"%s","run":"%s","previous":"%s"}\n' \
    "$(now)" "$component" "$1" "$2" "$(json "$3")" "$(json "$4")" "$(json "$5")" "$(json "$6")" >> deploy-history.jsonl
  echo "$(now) $3 $4 github-actions $1 run $5: $2" >> releases.log
  chmod 600 deploy-history.jsonl releases.log
}

healthy() {
  local state
  for _ in $(seq 1 75); do
    state=$(docker inspect "$service" --format '{{.State.Health.Status}}' 2>/dev/null || echo missing)
    [ "$state" = healthy ] && return 0
    sleep 2
  done
  return 1
}

# Application checks after the container is healthy. All read-only: GET/HEAD, plus one POST
# with an unparsable body that the registration route rejects before it could reach a backend.
# `deploy` also requires customer registration to be configured (that POST answers 400, not
# 503): a marketing release that could not register customers is rolled back. `rollback` skips
# that check, so an older release can always be restored.
smoke() { # expected-commit [registration]
  local expected="$1" require_registration="${2:-}" health code
  health=$(curl -s --max-time 10 "http://127.0.0.1:${port}/api/health" || true)
  case "$health" in *'"status":"ready"'*) ;; *) echo "check=health-not-ready"; return 1 ;; esac
  case "$health" in *"\"commitSha\":\"${expected}\""*) ;; *) echo "check=wrong-commit"; return 1 ;; esac
  if [ "$component" = marketing ]; then
    for path in / /pricing /contact; do
      code=$(curl -s -o /dev/null -w '%{http_code}' --max-time 15 "http://127.0.0.1:${port}${path}" || true)
      [ "$code" = 200 ] || { echo "check=page-${path}-${code}"; return 1; }
    done
    if [ "$require_registration" = registration ]; then
      code=$(curl -s -o /dev/null -w '%{http_code}' --max-time 10 -X POST -H 'content-type: application/json' \
        -H 'sec-fetch-site: same-origin' --data '{' "http://127.0.0.1:${port}/api/registration/resend" || true)
      [ "$code" = 400 ] || { echo "check=registration-not-configured-${code}"; return 1; }
    fi
  else
    case "$health" in *'"authentication":"configured"'*) ;; *) echo "check=portal-auth-unconfigured"; return 1 ;; esac
    case "$health" in *'"sessionStore":"postgres"'*) ;; *) echo "check=portal-session-store"; return 1 ;; esac
    # An unknown session must resolve to sign-in: proves the database is reachable.
    code=$(curl -s -o /dev/null -w '%{http_code}' --max-time 15 \
      -H 'Cookie: __Host-rp_session=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA' "http://127.0.0.1:${port}/download" || true)
    [ "$code" = 307 ] || [ "$code" = 303 ] || { echo "check=portal-session-lookup-${code}"; return 1; }
  fi
  return 0
}

# Reported, never changed: how the public reaches the portal.
report_modes() {
  if [ "$component" = portal ]; then
    if grep -q 'redactplus_portal_staff' "$HOME_SITE" 2>/dev/null; then echo "portal_access=staff-preview"
    elif grep -q 'not open yet' "$HOME_SITE" 2>/dev/null; then echo "portal_access=holding"
    elif [ -f "$HOME_SITE" ]; then echo "portal_access=public"
    else echo "portal_access=none"; fi
  fi
}

status() {
  local image labels
  echo "component=$component"
  echo "release_sha=$(pin RELEASE_SHA)"
  echo "release_digest=$(pin RELEASE_DIGEST)"
  echo "last_run=$(last_run)"
  echo "container=$(docker inspect "$service" --format '{{.State.Status}}/{{.State.Health.Status}}' 2>/dev/null || echo absent)"
  image=$(docker inspect "$service" --format '{{.Config.Image}}' 2>/dev/null || true)
  if [ -n "$image" ]; then
    labels=$(docker image inspect "$image" --format '{{index .Config.Labels "io.safaridesk.redactplus.portal-url"}}' 2>/dev/null || true)
    echo "image_portal_url=${labels}"
  fi
  report_modes
}

up_pin() { # tag digest
  printf 'RELEASE_SHA=%s\nRELEASE_DIGEST=%s\n' "$1" "$2" > .env.next
  chmod 600 .env.next
  mv .env.next .env
  docker compose config --quiet >/dev/null 2>&1 && docker compose up -d --no-deps "$service" >/dev/null 2>&1
}

# One deployment per component at a time; a second request waits up to 10 minutes.
exec 9>"$dir/.deploy.lock"
flock -w 600 9 || refuse "another deployment of $component is still running"

case "$action" in
  status)
    [ "${#args[@]}" -eq 2 ] || refuse "unexpected arguments"
    status
    ;;

  deploy)
    [ "${#args[@]}" -eq 5 ] || refuse "unexpected arguments"
    tag="${args[2]}"; digest="${args[3]}"; run="${args[4]}"
    [[ "$tag" =~ ^[0-9a-f]{40}$ ]] || refuse "bad tag"
    [[ "$digest" =~ ^sha256:[0-9a-f]{64}$ ]] || refuse "bad digest"
    [[ "$run" =~ ^[0-9]{1,9}$ ]] || refuse "bad run number"
    commit="$tag"
    previous="$(pin RELEASE_SHA)"

    # An older pipeline run never replaces a newer one, whatever order the runs finish in.
    if [ "$run" -le "$(last_run)" ]; then
      echo "result=skipped"; echo "reason=run $run is not newer than deployed run $(last_run)"
      exit 3
    fi
    if [ "$tag" = "$previous" ] && [ "$digest" = "$(pin RELEASE_DIGEST)" ]; then
      echo "$run" > .deploy-run
      echo "result=skipped"; echo "reason=already deployed"
      exit 3
    fi

    docker pull --quiet "${repo}:${tag}@${digest}" >/dev/null 2>&1 || refuse "image not found in the registry"
    revision=$(docker image inspect "${repo}:${tag}@${digest}" --format '{{index .Config.Labels "org.opencontainers.image.revision"}}' 2>/dev/null || true)
    [ "$revision" = "$commit" ] || refuse "image revision label does not match the commit"

    [ -f .env ] && cp -p .env .env.previous
    echo "previous_sha=$previous"
    if up_pin "$tag" "$digest" && healthy && smoke "$commit" registration; then
      echo "$run" > .deploy-run
      record deploy deployed "$tag" "$digest" "$run" "$previous"
      echo "result=deployed"; echo "release_sha=$tag"; echo "release_digest=$digest"
      report_modes
      exit 0
    fi

    # Failed: put the previous release back and prove it is healthy again.
    echo "rollback=started"
    if [ -f .env.previous ]; then
      cp -p .env.previous .env
      if docker compose up -d --no-deps "$service" >/dev/null 2>&1 && healthy; then
        echo "rollback=healthy"
        record deploy failed-rolled-back "$tag" "$digest" "$run" "$previous"
      else
        echo "rollback=unhealthy"
        record deploy failed-rollback-unhealthy "$tag" "$digest" "$run" "$previous"
      fi
    else
      echo "rollback=no-previous-release"
      record deploy failed-no-previous "$tag" "$digest" "$run" ""
    fi
    echo "result=failed"
    report_modes
    exit 1
    ;;

  rollback)
    [ "${#args[@]}" -eq 3 ] || refuse "unexpected arguments"
    run="${args[2]}"
    [[ "$run" =~ ^[0-9]{1,9}$ ]] || refuse "bad run number"
    [ -f .env.previous ] || refuse "no previous release recorded"
    current="$(pin RELEASE_SHA)"
    cp -p .env .env.rolled-back-from
    cp -p .env.previous .env
    if docker compose up -d --no-deps "$service" >/dev/null 2>&1 && healthy && smoke "$(pin RELEASE_SHA)"; then
      record rollback rolled-back "$(pin RELEASE_SHA)" "$(pin RELEASE_DIGEST)" "$run" "$current"
      echo "result=rolled-back"; echo "release_sha=$(pin RELEASE_SHA)"
      report_modes
    else
      cp -p .env.rolled-back-from .env
      docker compose up -d --no-deps "$service" >/dev/null 2>&1 || true
      record rollback failed-restored "$(pin RELEASE_SHA)" "$(pin RELEASE_DIGEST)" "$run" "$current"
      echo "result=failed"; exit 1
    fi
    ;;

  *) refuse "unknown action" ;;
esac
