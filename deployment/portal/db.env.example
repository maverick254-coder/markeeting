# Credentials for the portal's own PostgreSQL (/root/deploy/redactplus-portal/db.env,
# mode 600, root-owned). Read by the postgres container on FIRST start only, when it
# creates the database; changing them later does not change the existing role.
#
# Generate the password on the server, never on a laptop, and never paste it into chat:
#   openssl rand -base64 32 | tr -d '/+=' | cut -c1-40
# The same password goes into PORTAL_DATABASE_URL in app.env.
POSTGRES_DB=redactplus_portal
POSTGRES_USER=redactplus_portal
POSTGRES_PASSWORD=replace-with-a-generated-password
# Network connections (the portal) use SCRAM, the image default. The local socket is
# reachable only through `docker exec`, that is, by root on the host (used for backups).
