# Runtime settings for /root/deploy/redactplus-landing/app.env (mode 600, root-owned).
# Names and placeholders only. Every value here is read at request time, so changing
# one needs `docker compose up -d` (a container restart), not a new image.
#
# Integrations stay off until each has its own approved RedactPlus values. Never reuse
# the SafariDesk, saferedact.io or Netlify-production values for this deployment.

# --- Reverse proxy ---
# Host nginx is the only hop and overwrites X-Forwarded-For with the client address,
# so exactly one trusted hop. Used for contact-form rate limiting.
TRUST_PROXY_HOPS=1

# --- CMS (Decap at /admin) ---
# Off for this deployment: /admin/config.yml serves the disabled profile (.invalid
# origins), so the editor cannot authenticate.
CMS_ENABLED=false

# --- Support chat (Chatwoot) ---
# Off unless a dedicated RedactPlus inbox is approved. All three must be valid to enable.
OPENREDAKT_CHATWOOT_ENABLED=false
# OPENREDAKT_CHATWOOT_BASE_URL=https://replace-with-the-dedicated-chatwoot-origin
# OPENREDAKT_CHATWOOT_WEBSITE_TOKEN=replace-with-the-public-website-token

# --- Demo and contact enquiries (/api/contact) ---
# Leave all unset: forms validate and tell the visitor nothing was delivered.
# All four main values must be set together to switch delivery on.
# LEAD_DELIVERY_ENDPOINT=replace-with-the-provider-https-endpoint
# LEAD_DELIVERY_TOKEN=replace-with-the-provider-api-token
# LEAD_DELIVERY_FROM=replace-with-a-verified-sender-address
# LEAD_DELIVERY_TO=replace-with-the-enquiries-mailbox
# LEAD_DELIVERY_TIMEOUT_MS=5000

# --- Blog comments and moderation ---
# Leave unset: comments are refused rather than accepted into nowhere.
# COMMENTS_DATABASE_URL=replace-with-postgres-connection-url
# COMMENTS_DATABASE_SSL=true
# COMMENTS_ABUSE_SECRET=replace-with-a-fresh-32-byte-base64url-key
# COMMENTS_STAFF_GITHUB_USER_IDS=replace-with-numeric-staff-ids
# CMS_GITHUB_REPOSITORY=Safe-Redact/Marketing-Site

# Build-time values do NOT belong here: NEXT_PUBLIC_DOCUMENTATION_URL and SITE_NOINDEX
# are fixed into the image when it is built (see README.md).
