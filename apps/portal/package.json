{
  "name": "redactplus-portal",
  "version": "0.1.0",
  "private": true,
  "description": "RedactPlus customer portal (home.redactplus.io): sign-in through the shared identity provider, desktop downloads and account.",
  "scripts": {
    "dev": "next dev -p 3200",
    "dev:idp": "node dev/mock-idp/server.mjs",
    "build": "npm run releases:validate && next build",
    "start": "next start -p 3200",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "releases:validate": "tsx scripts/validate-releases.ts",
    "releases:verify": "tsx scripts/verify-release.ts",
    "releases:import": "tsx scripts/import-github-release.ts",
    "test": "npm run test:unit && npm run test:routes",
    "test:unit": "tsx --test tests/*.test.ts",
    "test:routes": "node tests/routes/run-route-tests.mjs",
    "dev:api": "node dev/mock-customer-api/server.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "next": "15.5.29",
    "openid-client": "6.8.8",
    "pg": "^8.16.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.3.1",
    "yaml": "^2.8.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.27.0",
    "eslint-config-next": "15.5.29",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.6",
    "typescript": "^5.8.3"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.26"
    }
  }
}
