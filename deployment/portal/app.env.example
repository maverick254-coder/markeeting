# Runtime settings for /root/deploy/redactplus-portal/app.env (mode 600, root-owned).
# Names and placeholders only. Read at request time: change one, then `docker compose up -d`.
# Do not set PORTAL_ENVIRONMENT here: production rules apply only when it is unset.

PORTAL_PUBLIC_ORIGIN=https://home.redactplus.io
PORTAL_MARKETING_ORIGIN=https://redactplus.io

# 32+ random bytes, generated on the server: openssl rand -base64 48 | tr '+/' '-_' | tr -d '='
# Rotating it signs every customer out of the portal.
PORTAL_SESSION_SECRET=replace-with-a-generated-secret

# The portal's own database (the redactplus-portal-db service in compose.yaml). Same password
# as POSTGRES_PASSWORD in db.env. The connection never leaves the internal Docker network
# (redactplus-portal-db, internal: true), so it runs without TLS.
PORTAL_SESSION_STORE=postgres
PORTAL_DATABASE_URL=postgres://redactplus_portal:replace-with-the-db-password@redactplus-portal-db:5432/redactplus_portal
PORTAL_DATABASE_SSL=false

# Production identity provider: Keycloak realm "saferedact" behind admin.redactplus.io.
# The client "redactplus-portal" is PUBLIC (no secret; PKCE S256), defined in the Admin Panel's
# realm file (7026a19) and present on the live realm (verified 6 Nov 2026 from the public
# authorize endpoint). Its redirect URIs are https://home.redactplus.io/*.
# Do not set PORTAL_OIDC_CLIENT_SECRET for it, and leave PORTAL_OIDC_REGISTRATION_PROMPT unset:
# the realm has self-registration off; accounts come from the website's trial registration.
PORTAL_OIDC_ISSUER=https://admin.redactplus.io/identity/realms/saferedact
PORTAL_OIDC_CLIENT_ID=redactplus-portal

# Exact host names verified installer URLs may use. The v0.3.8 installer is a GitHub release
# asset; github.com redirects to its signed download host, which the browser follows.
PORTAL_DOWNLOAD_ALLOWED_HOSTS=github.com

# The Control Center API, for GET /portal/me (profile, licence, trial and credits). Server to
# server, with the signed-in person's access token. Unset: the home page shows no licence panel.
PORTAL_CUSTOMER_API_URL=https://api.saferedact.io

PORTAL_ACCOUNT_MANAGEMENT_URL=https://admin.redactplus.io/identity/realms/saferedact/account
PORTAL_SUPPORT_EMAIL=support@redactplus.io

# Host nginx overwrites X-Forwarded-For with the visitor's address (taken from Cloudflare's
# CF-Connecting-IP only when the peer is Cloudflare): exactly one trusted hop.
TRUST_PROXY_HOPS=1

# Customer forum (deployment/forum). Off unless PORTAL_FORUM_ENABLED=true: no forum page, route
# or navigation exists until then. Turn it on only after the forum is installed and approved, and
# run the portal with compose.forum.yaml so it can reach NodeBB on the private network.
# PORTAL_FORUM_ENABLED=true
# PORTAL_FORUM_BRIDGE_URL=http://redactplus-forum:4567
# Same value as REDACTPLUS_BRIDGE_KEY in the forum's forum.env.
# PORTAL_FORUM_BRIDGE_KEY=
# PORTAL_FORUM_MODERATOR_ROLE=forum-moderator
