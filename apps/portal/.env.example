# RedactPlus portal (home.redactplus.io). Names and placeholders only: never commit values.
# Copy to .env.local for development. Production values come from app.env on the server
# (deployment/portal/app.env.example).

# production (default) | development | test. Non-production is refused unless the portal
# itself runs on a loopback origin (localhost / 127.0.0.1).
PORTAL_ENVIRONMENT=development
PORTAL_PUBLIC_ORIGIN=http://localhost:3200
PORTAL_MARKETING_ORIGIN=http://localhost:3000

# 32+ random bytes, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
PORTAL_SESSION_SECRET=

# postgres (production) | memory (local development and tests only)
PORTAL_SESSION_STORE=memory
# PORTAL_DATABASE_URL=
# PORTAL_DATABASE_SSL=true

# Identity provider (Keycloak). Leave the issuer and client id unset and sign-in reports itself
# unavailable. Production uses the PUBLIC client redactplus-portal (no secret, PKCE S256). For
# local development, run the development provider as a public client too:
#   MOCK_IDP_PUBLIC_CLIENT=true npm run dev:idp
# (or give it MOCK_IDP_CLIENT_SECRET and set the same PORTAL_OIDC_CLIENT_SECRET here).
PORTAL_OIDC_ISSUER=http://127.0.0.1:3201
PORTAL_OIDC_CLIENT_ID=redactplus-portal-dev
# PORTAL_OIDC_CLIENT_SECRET=
# PORTAL_OIDC_SCOPES=openid profile email
# Unset: no prompt is sent (the realm has self-registration off). Only for a provider that offers it.
# PORTAL_OIDC_REGISTRATION_PROMPT=

# Comma-separated exact host names that installer URLs in content/releases.json may use.
# github.com serves the RedactPlus Desktop installer (GitHub Releases).
PORTAL_DOWNLOAD_ALLOWED_HOSTS=github.com
# PORTAL_RELEASES_MANIFEST_PATH=

# The Control Center API for GET /portal/me (production: https://api.saferedact.io). Locally, the
# development stand-in answers with the verified shapes: npm run dev:api (127.0.0.1:3295).
# Unset: the home page shows no licence panel.
# PORTAL_CUSTOMER_API_URL=http://127.0.0.1:3295

# Optional links.
# PORTAL_ACCOUNT_MANAGEMENT_URL=
# PORTAL_SUPPORT_EMAIL=
# The newest published installer, read while the portal runs so a release shows on the download
# page without editing content/releases.json (issue #234). In production it reads the latest
# release of Safe-Redact/redactplus-downloads unless this says otherwise; "off" switches it off.
# PORTAL_LATEST_RELEASE_URL=https://github.com/Safe-Redact/redactplus-downloads/releases/latest/download/release.json (production default)
# Every earlier published installer, so it stays under Previous versions after a newer one ships.
# Lists the downloads repository's releases (one unauthenticated GitHub API call per 10 minutes)
# and reads each release.json once. Production default below; "off" switches it off, and it is
# also off when PORTAL_LATEST_RELEASE_URL is "off" and this is not set.
# PORTAL_RELEASE_HISTORY_URL=https://api.github.com/repos/Safe-Redact/redactplus-downloads/releases?per_page=30 (production default)

# Number of trusted reverse-proxy hops in X-Forwarded-For (1 behind host nginx).
# TRUST_PROXY_HOPS=0

# Development only: sample forum questions, with a visible banner. Refused in production.
# PORTAL_DEV_COMMUNITY_FIXTURES=true
