# Settings for /root/deploy/redactplus-cms-oauth/broker.env (mode 600, root-owned).
# Names and placeholders only. Never commit the real file or paste its values into chat,
# tickets or logs. Changing a value needs `docker compose up -d` (a restart).
#
# The transport settings (OAUTH_TLS_TERMINATION, OAUTH_BIND_HOST, OAUTH_PORT) are fixed in
# compose.yaml; TLS is terminated by host nginx, so no certificate paths belong here.

# --- GitHub OAuth App (Safe-Redact organisation) ---
# Homepage URL: https://redactplus.io
# Authorization callback URL (the only one): https://cms-auth.redactplus.io/callback
# The client ID is public; the secret is not.
GITHUB_OAUTH_CLIENT_ID=replace-with-the-oauth-app-client-id
GITHUB_OAUTH_CLIENT_SECRET=replace-with-the-oauth-app-client-secret

# --- Origins ---
OAUTH_PUBLIC_ORIGIN=https://cms-auth.redactplus.io
OAUTH_CALLBACK_URL=https://cms-auth.redactplus.io/callback
# The admin origin, byte for byte equal to PUBLIC_SITE_ORIGIN in the marketing app.env.
OAUTH_ALLOWED_ORIGINS=https://redactplus.io

# --- Who may log in ---
OAUTH_ALLOWED_REPOSITORY=Safe-Redact/Marketing-Site
# Numeric GitHub user IDs (not logins), comma-separated. Each also needs push access to
# the repository. Look one up with: curl -s https://api.github.com/users/LOGIN | grep '"id"'
OAUTH_ALLOWED_GITHUB_USER_IDS=replace-with-numeric-staff-ids
# The repository is private, so repo; public_repo cannot write to it. Must equal
# CMS_AUTH_SCOPE in the marketing app.env.
OAUTH_GITHUB_SCOPE=repo

# --- State signing ---
# Exactly 32 bytes, base64url (43 characters). Generate on the server, never reuse:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
OAUTH_STATE_SECRET=replace-with-a-fresh-32-byte-base64url-key

# --- Optional limits (defaults shown) ---
# OAUTH_TRANSACTION_TTL_SECONDS=600
# OAUTH_MAX_PENDING_TRANSACTIONS=1024
# OAUTH_REQUEST_TIMEOUT_MS=5000
