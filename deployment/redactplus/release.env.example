# Release pin for /root/deploy/redactplus-landing/.env (Compose reads it for
# interpolation only; it is not passed into the container).
#
# Both values come from the approved release record: the full commit SHA the image
# was built from, and the registry digest printed by `docker push`. Keep the
# previous file as .env.previous so a rollback is one copy and one `up -d`.
RELEASE_SHA=replace-with-the-40-character-commit-sha
RELEASE_DIGEST=sha256:replace-with-the-64-character-registry-digest
