# Runtime settings for /root/deploy/redactplus-portal/app.env (mode 600, root-owned).
# Names and placeholders only. Read at request time: change one, then `docker compose up -d`.
# Do not set PORTAL_ENVIRONMENT here: production rules apply only when it is unset.

PORTAL_PUBLIC_ORIGIN=https://home.redactplus.io
PORTAL_MARKETING_ORIGIN=https://redactplus.io

# 32+ random bytes. Rotating it signs every customer out of the portal.
PORTAL_SESSION_SECRET=<generate>

PORTAL_SESSION_STORE=postgres
PORTAL_DATABASE_URL=<postgres connection string for the portal's own database>
PORTAL_DATABASE_SSL=true

# Supplied by the backend team (confidential client "redactplus-portal"). Until all three
# are set, sign-in reports itself unavailable. NOT YET ISSUED.
# PORTAL_OIDC_ISSUER=https://<identity host>/identity/realms/saferedact
# PORTAL_OIDC_CLIENT_ID=redactplus-portal
# PORTAL_OIDC_CLIENT_SECRET=<from the backend team>
# PORTAL_OIDC_REGISTRATION_PROMPT=create

# Exact host names that verified installer URLs may use. Empty offers no download.
# PORTAL_DOWNLOAD_ALLOWED_HOSTS=

# Proposed customer API; NOT YET AVAILABLE. Unset: licence status "not shown yet".
# PORTAL_CUSTOMER_API_URL=

# PORTAL_ACCOUNT_MANAGEMENT_URL=https://<identity host>/identity/realms/saferedact/account
# PORTAL_SUPPORT_EMAIL=

# Host nginx overwrites X-Forwarded-For with the client address: one trusted hop.
TRUST_PROXY_HOPS=1
